{
  // EVERYTHING HERE IS PINNED ON PURPOSE. A floating version is a live
  // dependency on someone else's release schedule. Test in a fresh Codespace
  // before you rely on a change here.
  "name": "osu-llm-workshop: plain Python against one model endpoint",

  // A finished image, built ahead of time from github.com/jhassell/osu-llm-workshop-image
  // and pinned by digest. It already holds Python 3.12, the workshop's Python
  // libraries, Node 22.23.2 for the optional OpenClaw follow-on, an SSH server
  // (so the instructor can use `gh codespace ssh` and `gh codespace logs`) and
  // the GitHub CLI, so creating a Codespace installs nothing and there is no
  // features block. The image is kept small on purpose: a Codespace's first
  // open is mostly the time it takes to download it. To change the libraries, rebuild the image and
  // paste the new digest here; requirements.txt must match what the image holds.
  "image": "ghcr.io/jhassell/osu-llm-workshop-devcontainer@sha256:1d432893c83955a81406ca0d50a670cfb6587472dcb6002c49ec804cd9ebf648",

  // onCreateCommand, NOT postCreateCommand: GitHub runs onCreateCommand inside
  // a Codespaces prebuild and never runs postCreateCommand there. Without a
  // prebuild it runs once, while the Codespace is created. With the libraries
  // already in the image it only installs the autostart line and checks imports.
  "onCreateCommand": "bash .devcontainer/postCreate.sh",

  // NO postAttachCommand. It would open a second terminal that takes focus and
  // hides the first one, where setup.sh runs (see .devcontainer/autostart.sh).

  // Two cores: the labs mostly wait on the model. Quota is billed in
  // core-hours, so 2 cores last twice as long as 4.
  "hostRequirements": { "cpus": 2 },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "mechatroner.rainbow-csv"
      ]
    }
  }
}
