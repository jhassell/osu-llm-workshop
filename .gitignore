# Your own documents for the labs. They stay in your Codespace.
mine/*

# What the labs write. Built from your documents, so it can hold their text;
# kept out of git so it is never committed by accident.
03_table/records.jsonl
03_table/records.unusable*.jsonl
**/trace*.json

# Secrets: nothing with a key in it belongs in git.
.env
.env.*
*.key

# Junk
__pycache__/
.ipynb_checkpoints/
.DS_Store

# Keep the folder and its note, nothing else in it.
!mine/README.md
