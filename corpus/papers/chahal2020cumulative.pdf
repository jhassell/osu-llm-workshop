                           <xmpG:mode>RGB</xmpG:mode>
                           <xmpG:red>205</xmpG:red>
                           <xmpG:green>221</xmpG:green>
                           <xmpG:blue>228</xmpG:blue>
                        </rdf:li>
                     </rdf:Seq>
                  </xmpG:Colorants>
               </rdf:li>
